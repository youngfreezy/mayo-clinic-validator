# Required — OpenAI API key for GPT-4o and embeddings
OPENAI_API_KEY=sk-your-key-here

# Local Postgres (Docker container maps 5433 on host → 5432 inside container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mayo_validation

# Optional — enable LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-your-key-here
# LANGCHAIN_PROJECT=mayo-clinic-validator

# Optional — Neo4j Aura (graph database for validation rules)
# If not set, the system falls back to validation_rules.json (local file)
# Sign up free at https://neo4j.com/cloud/aura-free/
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password-here
